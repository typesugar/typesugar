{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "plugins": [{ "name": "@typesugar/transformer/language-service" }]
  },
  "include": ["src/**/*.ts"]
}
