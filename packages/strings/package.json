{
  "name": "@typesugar/strings",
  "version": "0.1.1",
  "description": "String interpolation macros (regex, html, fmt, raw) for typesugar",
  "author": "Dean Povey <dean.povey@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/typesugar/typesugar.git",
    "directory": "packages/strings"
  },
  "homepage": "https://github.com/typesugar/typesugar/tree/main/packages/strings#readme",
  "bugs": {
    "url": "https://github.com/typesugar/typesugar/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./macros": {
      "import": {
        "types": "./dist/macros.d.ts",
        "default": "./dist/macros.js"
      },
      "require": {
        "types": "./dist/macros.d.cts",
        "default": "./dist/macros.cjs"
      }
    }
  },
  "typesugar": {
    "macros": "./macros"
  },
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "vitest": "^3.0.0"
  },
  "keywords": [
    "typescript",
    "macros",
    "strings",
    "interpolation",
    "template-literals"
  ],
  "dependencies": {
    "@typesugar/core": "workspace:*"
  },
  "peerDependencies": {
    "typescript": ">=5.9.0 <7.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false
}
