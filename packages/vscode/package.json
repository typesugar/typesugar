{
  "name": "typesugar-vscode",
  "version": "0.1.1",
  "description": "IDE support for typesugar — macro-aware TypeScript through the bundled TypeScript server plugin, syntax highlighting, and macro expansion views",
  "author": "Dean Povey <dean.povey@gmail.com>",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/typesugar/typesugar.git",
    "directory": "packages/vscode"
  },
  "homepage": "https://github.com/typesugar/typesugar/tree/main/packages/vscode#readme",
  "bugs": {
    "url": "https://github.com/typesugar/typesugar/issues"
  },
  "license": "MIT",
  "displayName": "typesugar",
  "publisher": "typesugar",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Other"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "typesugar runs the workspace's macro packages (and its typesugar.config) inside the TypeScript server, which executes code from the workspace. In Restricted Mode the extension, and the TypeScript server plugin it contributes, stay off until you trust the folder."
    }
  },
  "activationEvents": [
    "workspaceContains:**/node_modules/typesugar/package.json"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "grammars": [
      {
        "scopeName": "source.ts.typesugar",
        "path": "./syntaxes/typesugar.tmLanguage.json",
        "injectTo": [
          "source.ts",
          "source.tsx"
        ]
      },
      {
        "scopeName": "source.ts.typesugar.units",
        "path": "./syntaxes/typesugar-units.tmLanguage.json",
        "injectTo": [
          "source.ts",
          "source.tsx"
        ]
      }
    ],
    "commands": [
      {
        "command": "typesugar.expandMacro",
        "title": "typesugar: Expand Macro at Cursor"
      },
      {
        "command": "typesugar.showTransformed",
        "title": "typesugar: Show Transformed Source"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "typesugar.expandMacro",
          "when": "editorLangId == typescript || editorLangId == typescriptreact",
          "group": "typesugar@1"
        },
        {
          "command": "typesugar.showTransformed",
          "when": "editorLangId == typescript || editorLangId == typescriptreact",
          "group": "typesugar@2"
        }
      ],
      "commandPalette": [
        {
          "command": "typesugar.expandMacro",
          "when": "editorLangId == typescript || editorLangId == typescriptreact"
        },
        {
          "command": "typesugar.showTransformed",
          "when": "editorLangId == typescript || editorLangId == typescriptreact"
        }
      ]
    },
    "typescriptServerPlugins": [
      {
        "name": "@typesugar/ts-plugin",
        "enableForWorkspaceTypeScriptVersions": true
      }
    ],
    "configuration": {
      "title": "typesugar",
      "properties": {
        "typesugar.comptimeInEditor": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Evaluate `comptime(...)` blocks in the editor (trusted workspaces only). comptime runs code with editor privileges."
        }
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vscode-test",
    "test:watch": "vitest",
    "prepackage": "node scripts/bundle-ts-plugin.js",
    "package": "vsce package --no-dependencies && node scripts/inject-ts-plugin.js",
    "publish": "vsce publish --no-dependencies"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.1",
    "tsup": "^8.5.1",
    "typescript": "^5.8.3",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@typesugar/core": "workspace:*",
    "@typesugar/ts-plugin": "workspace:*"
  },
  "bundledDependencies": [
    "@typesugar/ts-plugin"
  ],
  "sideEffects": true
}
