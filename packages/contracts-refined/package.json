{
  "name": "@typesugar/contracts-refined",
  "version": "0.1.1",
  "description": "🧊 Integrate @typesugar/contracts with @typesugar/type-system refinement types — single source of truth for type predicates",
  "author": "Dean Povey <dean.povey@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/typesugar/typesugar.git",
    "directory": "packages/contracts-refined"
  },
  "homepage": "https://github.com/typesugar/typesugar/tree/main/packages/contracts-refined#readme",
  "bugs": {
    "url": "https://github.com/typesugar/typesugar/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "typesugar": {
    "macros": "."
  },
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "typescript",
    "macros",
    "contracts",
    "refinement-types",
    "type-system",
    "integration"
  ],
  "dependencies": {
    "@typesugar/contracts": "workspace:*",
    "@typesugar/type-system": "workspace:*"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0 <6.0.0"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": [
    "./dist/index.js",
    "./dist/index.cjs",
    "./src/index.ts"
  ]
}
