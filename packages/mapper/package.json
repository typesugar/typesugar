{
  "name": "@typesugar/mapper",
  "version": "0.1.1",
  "description": "Zero-cost compile-time object mapping and transformation",
  "author": "Dean Povey <dean.povey@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/typesugar/typesugar.git",
    "directory": "packages/mapper"
  },
  "homepage": "https://github.com/typesugar/typesugar/tree/main/packages/mapper#readme",
  "bugs": {
    "url": "https://github.com/typesugar/typesugar/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./macros": {
      "import": {
        "types": "./dist/macros.d.ts",
        "default": "./dist/macros.js"
      },
      "require": {
        "types": "./dist/macros.d.cts",
        "default": "./dist/macros.cjs"
      }
    }
  },
  "typesugar": {
    "macros": "./macros"
  },
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "showcase": "typesugar run examples/showcase.ts"
  },
  "keywords": [
    "typescript",
    "macros",
    "mapping",
    "transform",
    "automapper"
  ],
  "dependencies": {
    "@typesugar/core": "workspace:*"
  },
  "peerDependencies": {
    "typescript": ">=5.9.0 <7.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "unplugin-typesugar": "workspace:*",
    "vitest": "^3.0.0"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false
}
