{
  "name": "@typesugar/fp",
  "version": "0.1.1",
  "description": "Functional programming library with typeclasses and data types for typesugar",
  "author": "Dean Povey <dean.povey@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/typesugar/typesugar.git",
    "directory": "packages/fp"
  },
  "homepage": "https://github.com/typesugar/typesugar/tree/main/packages/fp#readme",
  "bugs": {
    "url": "https://github.com/typesugar/typesugar/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./data": {
      "import": {
        "types": "./dist/data/index.d.ts",
        "default": "./dist/data/index.js"
      },
      "require": {
        "types": "./dist/data/index.d.cts",
        "default": "./dist/data/index.cjs"
      }
    },
    "./data/either": {
      "import": {
        "types": "./dist/data/either.d.ts",
        "default": "./dist/data/either.js"
      },
      "require": {
        "types": "./dist/data/either.d.cts",
        "default": "./dist/data/either.cjs"
      }
    },
    "./io": {
      "import": {
        "types": "./dist/io/index.d.ts",
        "default": "./dist/io/index.js"
      },
      "require": {
        "types": "./dist/io/index.d.cts",
        "default": "./dist/io/index.cjs"
      }
    },
    "./typeclasses": {
      "import": {
        "types": "./dist/typeclasses/index.d.ts",
        "default": "./dist/typeclasses/index.js"
      },
      "require": {
        "types": "./dist/typeclasses/index.d.cts",
        "default": "./dist/typeclasses/index.cjs"
      }
    },
    "./syntax": {
      "import": {
        "types": "./dist/syntax/index.d.ts",
        "default": "./dist/syntax/index.js"
      },
      "require": {
        "types": "./dist/syntax/index.d.cts",
        "default": "./dist/syntax/index.cjs"
      }
    },
    "./zero-cost": {
      "import": {
        "types": "./dist/zero-cost/index.d.ts",
        "default": "./dist/zero-cost/index.js"
      },
      "require": {
        "types": "./dist/zero-cost/index.d.cts",
        "default": "./dist/zero-cost/index.cjs"
      }
    },
    "./macros": {
      "import": {
        "types": "./dist/macros.d.ts",
        "default": "./dist/macros.js"
      },
      "require": {
        "types": "./dist/macros.d.cts",
        "default": "./dist/macros.cjs"
      }
    },
    "./*": {
      "import": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      },
      "require": {
        "types": "./dist/*.d.cts",
        "default": "./dist/*.cjs"
      }
    }
  },
  "typesugar": {
    "macros": "./macros"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && node scripts/emit-dcts.mjs",
    "build:watch": "tsup --watch",
    "build:dts": "tsc -p tsconfig.build.json && node scripts/emit-dcts.mjs",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "typescript",
    "macros",
    "functional-programming",
    "fp",
    "typeclasses",
    "monad"
  ],
  "dependencies": {
    "@typesugar/contracts": "workspace:*",
    "@typesugar/core": "workspace:*",
    "@typesugar/macros": "workspace:*",
    "@typesugar/type-system": "workspace:*"
  },
  "devDependencies": {
    "unplugin-typesugar": "workspace:*"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0 <6.0.0"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": [
    "./dist/macros.js",
    "./dist/macros.cjs",
    "./dist/zero-cost/macros.js",
    "./dist/zero-cost/macros.cjs",
    "./src/macros.ts",
    "./src/zero-cost/macros.ts"
  ]
}
