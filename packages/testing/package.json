{
  "name": "@typesugar/testing",
  "version": "0.1.1",
  "description": "🧊 Compile-time testing macros — power assertions, property-based testing, type assertions",
  "author": "Dean Povey <dean.povey@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/typesugar/typesugar.git",
    "directory": "packages/testing"
  },
  "homepage": "https://github.com/typesugar/typesugar/tree/main/packages/testing#readme",
  "bugs": {
    "url": "https://github.com/typesugar/typesugar/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./macros": {
      "import": {
        "types": "./dist/macro.d.ts",
        "default": "./dist/macro.js"
      },
      "require": {
        "types": "./dist/macro.d.cts",
        "default": "./dist/macro.cjs"
      }
    }
  },
  "typesugar": {
    "macros": "./macros"
  },
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "typescript",
    "macros",
    "testing",
    "assertions",
    "property-based",
    "snapshot"
  ],
  "dependencies": {
    "@typesugar/core": "workspace:*",
    "@typesugar/macros": "workspace:*",
    "@typesugar/type-system": "workspace:*"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0 <6.0.0"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": [
    "./dist/macro.js",
    "./dist/macro.cjs",
    "./src/macro.ts"
  ]
}
