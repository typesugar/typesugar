{
  "name": "@typesugar/transformer",
  "version": "0.1.1",
  "description": "TypeScript transformer for typesugar macro expansion",
  "author": "Dean Povey <dean.povey@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/typesugar/typesugar.git",
    "directory": "packages/transformer"
  },
  "homepage": "https://github.com/typesugar/typesugar/tree/main/packages/transformer#readme",
  "bugs": {
    "url": "https://github.com/typesugar/typesugar/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "typesugar": "./dist/cli.js",
    "typesugar-dts-transform": "./dist/dts-transform-cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./cli": {
      "import": {
        "types": "./dist/cli.d.ts",
        "default": "./dist/cli.js"
      },
      "require": {
        "types": "./dist/cli.d.cts",
        "default": "./dist/cli.cjs"
      }
    },
    "./language-service": {
      "import": {
        "types": "./dist/language-service.d.ts",
        "default": "./dist/language-service.js"
      },
      "require": {
        "types": "./dist/language-service.d.cts",
        "default": "./dist/language-service.cjs"
      }
    },
    "./pipeline": {
      "import": {
        "types": "./dist/pipeline.d.ts",
        "default": "./dist/pipeline.js"
      },
      "require": {
        "types": "./dist/pipeline.d.cts",
        "default": "./dist/pipeline.cjs"
      }
    },
    "./virtual-host": {
      "import": {
        "types": "./dist/virtual-host.d.ts",
        "default": "./dist/virtual-host.js"
      },
      "require": {
        "types": "./dist/virtual-host.d.cts",
        "default": "./dist/virtual-host.cjs"
      }
    },
    "./position-mapper": {
      "import": {
        "types": "./dist/position-mapper.d.ts",
        "default": "./dist/position-mapper.js"
      },
      "require": {
        "types": "./dist/position-mapper.d.cts",
        "default": "./dist/position-mapper.cjs"
      }
    },
    "./source-map-utils": {
      "import": {
        "types": "./dist/source-map-utils.d.ts",
        "default": "./dist/source-map-utils.js"
      },
      "require": {
        "types": "./dist/source-map-utils.d.cts",
        "default": "./dist/source-map-utils.cjs"
      }
    },
    "./cache": {
      "import": {
        "types": "./dist/cache.d.ts",
        "default": "./dist/cache.js"
      },
      "require": {
        "types": "./dist/cache.d.cts",
        "default": "./dist/cache.cjs"
      }
    },
    "./profiling": {
      "import": {
        "types": "./dist/profiling.d.ts",
        "default": "./dist/profiling.js"
      },
      "require": {
        "types": "./dist/profiling.d.cts",
        "default": "./dist/profiling.cjs"
      }
    },
    "./dts-transform": {
      "import": {
        "types": "./dist/dts-transform.d.ts",
        "default": "./dist/dts-transform.js"
      },
      "require": {
        "types": "./dist/dts-transform.d.cts",
        "default": "./dist/dts-transform.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "typescript",
    "macros",
    "transformer",
    "ts-patch"
  ],
  "dependencies": {
    "@ampproject/remapping": "^2.3.0",
    "@typesugar/core": "workspace:*",
    "@typesugar/lsp-common": "workspace:*",
    "@typesugar/macros": "workspace:*",
    "@typesugar/transformer-core": "workspace:*",
    "esbuild": "^0.20.0",
    "magic-string": "^0.30.21",
    "xxhash-wasm": "^1.1.0"
  },
  "devDependencies": {
    "@typesugar/contracts": "workspace:*",
    "vitest": "^3.0.0"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0 <6.0.0"
  },
  "files": [
    "dist",
    "src",
    "language-service",
    "templates",
    "ai"
  ],
  "sideEffects": false
}
