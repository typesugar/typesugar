{
  "name": "@typesugar/macros",
  "version": "0.1.1",
  "description": "🧊 Built-in macro implementations for typesugar",
  "author": "Dean Povey <dean.povey@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/typesugar/typesugar.git",
    "directory": "packages/macros"
  },
  "homepage": "https://github.com/typesugar/typesugar/tree/main/packages/macros#readme",
  "bugs": {
    "url": "https://github.com/typesugar/typesugar/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./runtime": {
      "import": {
        "types": "./dist/runtime-stubs.d.ts",
        "default": "./dist/runtime-stubs.js"
      },
      "require": {
        "types": "./dist/runtime-stubs.d.cts",
        "default": "./dist/runtime-stubs.cjs"
      }
    }
  },
  "typesugar": {
    "macros": "."
  },
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "typescript",
    "macros",
    "metaprogramming",
    "typeclass",
    "derive"
  ],
  "dependencies": {
    "@typesugar/core": "workspace:*"
  },
  "devDependencies": {},
  "peerDependencies": {
    "typescript": ">=5.0.0 <6.0.0"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": true
}
