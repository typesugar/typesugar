{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    // Explicit since TypeScript 6.0, whose default for `types` is [] (5.x
    // auto-included every @types package): the sources use Node globals.
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "noEmit": true,
    "plugins": [
      {
        "transform": "@typesugar/transformer",
        "type": "program"
      },
      {
        "name": "@typesugar/ts-plugin"
      }
    ]
  }
}
